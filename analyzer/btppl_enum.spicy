module BTPPL_ENUM;

public type Version = enum {
    VERSION_1   = 0,
    RESERVED_1  = 1,
    RESERVED_2  = 2,
    RESERVED_3  = 3
};

public type Type = enum {
    REQUEST     = 0,
    RESPOND     = 1,
    MESSAGE     = 2,
    RESERVED_3  = 3,
    RESERVED_4  = 4,
    RESERVED_5  = 5,
    RESERVED_6  = 6,
    RESERVED_7  = 7,
    RESERVED_8  = 8
};

public type Sha1 = enum {
    without_sha1    = 0,
    with_sha1       = 1
};


